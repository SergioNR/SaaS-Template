# https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

# npm keeps a package.json's existing indentation - both packages use 4 spaces
[**/package.json]
indent_size = 4

# Trailing double spaces are hard line breaks in Markdown
[*.md]
trim_trailing_whitespace = false
