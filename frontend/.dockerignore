# Build context for frontend/Dockerfile - only what `npm ci` + `vite build`
# and the nginx stage need

# Dependencies and build output (rebuilt inside the image)
node_modules
dist
coverage

# Environment files - VITE_* values come in as build args
.env*
!.env.example

# Tests (never part of the bundle)
**/*.spec.*
**/*.test.*
**/tests
**/__tests__

# Docs and agent instructions
README*
AGENTS.md
CLAUDE.md

# Docker, VCS and editor files
Dockerfile*
.dockerignore
.git
.vscode
.DS_Store
**/.DS_Store
