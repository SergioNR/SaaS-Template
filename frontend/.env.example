# Base URL of the backend API
VITE_API_BASE_URL=http://localhost:3000

# Optional: PostHog project key. Analytics stay disabled when unset
VITE_PUBLIC_POSTHOG_KEY=

# Optional: PostHog ingestion host. Defaults to the EU cloud. Must match
# NGINX_CSP_POSTHOG_ORIGINS below
VITE_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Public URL of the deployed frontend - required for `npm run build`
# (canonical/og:url tags); the dev server defaults to http://localhost:5173
VITE_SITE_BASE_URL=http://localhost:5173

# --- Runtime (nginx container, not baked into the bundle) ---
# API origin allowed by the Content-Security-Policy connect-src. Defaults to
# the VITE_API_BASE_URL build arg; override with `docker run -e ...`
NGINX_CSP_API_ORIGIN=http://localhost:3000

# Space-separated extra origins allowed by the CSP connect-src - e.g. the
# S3/MinIO origin presigned uploads/downloads go to. Empty by default
NGINX_CSP_CONNECT_EXTRA=

# Space-separated PostHog origins allowed by the CSP script-src/connect-src
# (ingestion + assets host of VITE_PUBLIC_POSTHOG_HOST). Empty when analytics
# is off
NGINX_CSP_POSTHOG_ORIGINS="https://eu.i.posthog.com https://eu-assets.i.posthog.com"
