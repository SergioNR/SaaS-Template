generator client {
  provider     = "prisma-client"
  output       = "../server/config/generated/prisma/client"
  runtime      = "nodejs"
  moduleFormat = "esm"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String                @id @default(uuid())
  //* citext: uniqueness and every lookup are case-insensitive in the
  //* database itself (validators also lower-case, this is the backstop)
  email               String                @unique @db.Citext
  password            String
  role                UserRoles
  created_at          DateTime              @default(now())
  last_updated_at     DateTime              @default(now()) @updatedAt
  last_login_at       DateTime?
  //* Null only for superadmins - SaaS-provider staff who belong to no tenant
  //* company. Restrict (not Prisma's optional-relation SetNull default) so a
  //* company with members can still never be deleted out from under them
  company_id          String?
  Company             Company?              @relation(fields: [company_id], references: [id], onDelete: Restrict)
  PasswordResetTokens PasswordResetTokens[]
  UserRoles           UserRole[]
  File                File[]
  Sessions            Session[]
  IssuedTeamInvites   TeamInvites[]         @relation("TeamInviteInviter")

  @@index([company_id])
}

model Company {
  id           String         @id @default(uuid())
  name         String?
  User         User[]
  Subscription Subscription[]
  TeamInvites  TeamInvites[]
  File         File[]
  stripe_id    String?        @unique
  created_at   DateTime       @default(now())
  updated_at   DateTime       @default(now()) @updatedAt
}

model Role {
  id              String           @id @default(uuid())
  name            String           @unique
  created_at      DateTime         @default(now())
  RolePermissions RolePermission[]
  UserRoles       UserRole[]
  TeamInvites     TeamInvites[]
}

model Permission {
  id              String           @id @default(uuid())
  name            String           @unique
  RolePermissions RolePermission[]
}

model RolePermission {
  role_id       String
  permission_id String
  Role          Role       @relation(fields: [role_id], references: [id], onDelete: Cascade)
  Permission    Permission @relation(fields: [permission_id], references: [id], onDelete: Cascade)

  @@id([role_id, permission_id])
}

model UserRole {
  user_id String
  role_id String
  User    User   @relation(fields: [user_id], references: [id], onDelete: Cascade)
  Role    Role   @relation(fields: [role_id], references: [id], onDelete: Cascade)

  @@id([user_id, role_id])
}

model TeamInvites {
  id            String   @id @default(uuid())
  email         String   @db.Citext
  company_id    String
  role_id       String
  //* Invites die with their inviter - they are only as good as the person
  //* vouching for them (the deletion flow also deletes them explicitly)
  invited_by    String
  //* sha256 hex of the emailed secret token - the raw token is never stored
  token_hash    String   @unique
  token_expires DateTime
  created_at    DateTime @default(now())
  Company       Company  @relation(fields: [company_id], references: [id], onDelete: Cascade)
  Role          Role     @relation(fields: [role_id], references: [id])
  Inviter       User     @relation("TeamInviteInviter", fields: [invited_by], references: [id], onDelete: Cascade)

  @@unique([company_id, email])
  @@index([invited_by])
}

model PasswordResetTokens {
  id            String   @id @default(uuid())
  User          User     @relation(fields: [user_id], references: [id], onDelete: Cascade)
  user_id       String
  //* sha256 hex of the emailed secret token - the raw token is never stored
  token_hash    String   @unique
  token_expires DateTime
  created_at    DateTime @default(now())

  @@index([user_id])
}

model Session {
  id        String   @id
  sid       String   @unique
  data      String
  expiresAt DateTime
  //* Null until login links the session to its user; sessions die with it
  user_id   String?
  User      User?    @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@index([user_id])
  @@index([expiresAt])
}

model Subscription {
  id                     String    @id @default(uuid())
  company_id             String    @unique
  Company                Company   @relation(fields: [company_id], references: [id])
  created_at             DateTime  @default(now())
  updated_at             DateTime  @default(now()) @updatedAt
  expires_at             DateTime?
  //* Null for trial rows - set once a Stripe subscription backs the row, so
  //* the row id stays an internal uuid and "paid" is never inferred from an
  //* id prefix
  stripe_subscription_id String?   @unique
  //* Last Stripe status written by the webhook sync (null for trials)
  stripe_status          String?
  //* When the Stripe state written last was read from Stripe. The webhook
  //* fetches outside the company lock and drops a write whose read is older
  //* than the stored one, so a slow delivery can never clobber fresher state
  stripe_synced_at       DateTime?
}

model File {
  id                String     @id @default(uuid())
  company_id        String
  Company           Company    @relation(fields: [company_id], references: [id], onDelete: Cascade)
  uploaded_by       String?
  User              User?      @relation(fields: [uploaded_by], references: [id], onDelete: SetNull)
  s3_key            String     @unique
  original_filename String
  mime_type         String
  size_bytes        Int
  //* Rows start pending and only become ready once the uploaded object was
  //* verified against the declared size and MIME type (confirm endpoint)
  status            FileStatus @default(pending)
  created_at        DateTime   @default(now())
  //* Set by the pending-upload sweep the first time this row's bucket delete
  //* failed - the shared "already alerted" memory, so a stuck object alerts
  //* once whichever replica runs the sweep and across restarts
  cleanup_failed_at DateTime?

  @@index([company_id, created_at])
  @@index([status, created_at])
}

enum FileStatus {
  pending
  ready
}

//* Platform role - independent from the company roles (Role / UserRole).
//* `superadmin` is SaaS-provider staff: full /api/v1/admin access, no company
enum UserRoles {
  user
  superadmin
}
