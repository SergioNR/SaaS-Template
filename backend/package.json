{
    "name": "expressjs-template",
    "engines": {
        "node": ">=26"
    },
    "description": "Express.js server template with authentication, billing, and database integrations",
    "main": "server/app.js",
    "private": true,
    "version": "1.0.0",
    "type": "module",
    "keywords": [],
    "license": "Proprietary",
    "author": "Sergio Navarro Redondo",
    "scripts": {
        "start": "node --import tsx ./server/app.js",
        "start:local": "node --import tsx --watch --env-file=.env ./server/app.js",
        "stripe:listen": "stripe listen --forward-to localhost:3000/webhooks/v1/stripe",
        "test": "NODE_OPTIONS='--experimental-vm-modules' jest"
    },
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1161.0",
        "@aws-sdk/s3-request-presigner": "^3.1161.0",
        "@getbrevo/brevo": "^6.2.0",
        "@logtail/pino": "^0.5.13",
        "@prisma/adapter-pg": "^7.10.1",
        "@prisma/client": "^7.10.1",
        "@quixo3/prisma-session-store": "^3.1.13",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.5",
        "cron": "^4.3.4",
        "dotenv": "^18.0.9",
        "express": "^5.1.0",
        "express-rate-limit": "^8.7.3",
        "express-session": "^1.18.2",
        "express-slow-down": "^3.0.1",
        "express-validator": "^7.3.1",
        "helmet": "^8.1.0",
        "passport": "^0.7.0",
        "passport-local": "^1.0.0",
        "pino": "^10.1.0",
        "pino-http": "^11.0.0",
        "posthog-node": "^5.61.2",
        "prisma": "^7.10.1",
        "stripe": "^23.1.0",
        "swagger-jsdoc": "^6.3.0",
        "swagger-ui-express": "^5.0.1",
        "tsx": "^4.19.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.7",
        "@eslint/js": "^10.0.1",
        "@jest/globals": "^30.5.2",
        "@types/node": "^26.6.6",
        "eslint": "^10.14.0",
        "eslint-config-airbnb-base": "^15.0.0",
        "eslint-plugin-import": "^2.31.0",
        "globals": "^17.14.0",
        "jest": "^30.2.0",
        "pino-pretty": "^13.1.2",
        "supertest": "^7.3.2",
        "typescript": "^7.0.2"
    },
    "directories": {
        "test": "tests"
    },
    "overrides": {
        "argparse": "^2.0.0",
        "eslint-config-airbnb-base": {
            "eslint": "$eslint"
        },
        "eslint-plugin-import": {
            "eslint": "$eslint"
        }
    },
    "allowScripts": {
        "@parcel/watcher@2.6.0": true,
        "bcrypt@6.0.0": true,
        "@prisma/client@7.10.1": true,
        "esbuild@0.28.2": true,
        "fsevents@2.3.3": true,
        "unrs-resolver@1.12.2": true,
        "@prisma/engines@7.10.1": true,
        "prisma@7.10.1": true
    }
}
